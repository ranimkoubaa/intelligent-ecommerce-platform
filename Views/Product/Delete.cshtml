@model ProductManagement.Models.Product

@{
    ViewData["Title"] = "Supprimer le produit";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-danger border-2 rounded-4">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmation de suppression</h5>
            </div>

            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <img src="~/images/@(Model.Image ?? "noimage.jpg")"
                         class="rounded shadow-sm p-2"
                         style="max-height: 140px; object-fit: contain; background: #f8fafc;"
                         alt="@Model.Name" />
                </div>

                <h4 class="fw-bold text-dark">@Model.Name</h4>
                <p class="text-danger fw-semibold">Êtes-vous sûr de vouloir supprimer définitivement ce produit du catalogue ?</p>

                <div class="bg-light p-3 rounded-3 text-start mb-4">
                    <div class="row">
                        <div class="col-6"><span class="text-muted">Prix :</span> <span class="fw-bold">@Model.Price DT</span></div>
                        <div class="col-6"><span class="text-muted">Stock :</span> <span class="fw-bold">@Model.QteStock</span></div>
                        <div class="col-12 mt-2"><span class="text-muted">Catégorie :</span> <span class="badge bg-secondary">@Model.Category?.CategoryName</span></div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-2">
                    <input type="hidden" asp-for="ProductId" />
                    <button type="submit" class="btn btn-danger px-4 shadow">
                        <i class="bi bi-trash-fill"></i> Oui, supprimer
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        Annuler
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>