@model ProductManagement.Models.Product

@{
    ViewData["Title"] = "Détails du produit";
}

<h1>Détails du produit</h1>

<div class="card mb-4" style="max-width: 700px;">

    <div class="card-header">
        <h4 class="mb-0">@Model.Name</h4>
    </div>

    <div class="card-body">

        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <div class="text-center mb-4">
                <img src="~/images/@Model.Image"
                     class="img-fluid rounded"
                     style="max-height: 250px;"
                     alt="@Model.Name" />
            </div>
        }

        <dl class="row">

            <dt class="col-sm-2">Nom</dt>
            <dd class="col-sm-10">@Model.Name</dd>

            <dt class="col-sm-2">Prix</dt>
            <dd class="col-sm-10 fw-bold text-primary fs-5">@Model.Price DT</dd>

            <dt class="col-sm-2">Disponibilité</dt>
            <dd class="col-sm-10">
                @if (Model.QteStock > 5)
                {
                    <span class="badge bg-success">En stock (@Model.QteStock disponibles)</span>
                }
                else if (Model.QteStock > 0)
                {
                    <span class="badge bg-warning text-dark">Stock limité ! Plus que @Model.QteStock restant(s)</span>
                }
                else
                {
                    <span class="badge bg-danger">Rupture de stock</span>
                }
            </dd>

            <dt class="col-sm-2">Catégorie</dt>
            <dd class="col-sm-10">
                <span class="badge bg-info text-dark">@Model.Category?.CategoryName</span>
            </dd>

        </dl>

    </div>

    <div class="card-footer d-flex gap-2">
        <a asp-controller="Panier"
           asp-action="AddProduct"
           asp-route-id="@Model.ProductId"
           class="btn btn-success @(Model.QteStock <= 0 ? "disabled" : "")">
            🛒 Ajouter au Panier
        </a>

        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Edit"
               asp-route-id="@Model.ProductId"
               class="btn btn-warning">
                Modifier
            </a>
        }

        <a asp-action="Index"
           class="btn btn-secondary">
            Retour à la liste
        </a>
    </div>

</div>

<!-- ================= SYSTEME DE RECOMMANDATION INTELLIGENT ================= -->
@if (ViewBag.RecommendedProducts != null && ((IEnumerable<ProductManagement.Models.Product>)ViewBag.RecommendedProducts).Any())
{
    <div class="mt-5">
        <div class="d-flex align-items-center mb-3">
            <h3 class="mb-0 text-dark">✨ Produits Similaires & Recommandés</h3>
            <span class="badge bg-primary ms-3">Système IA & Machine Learning</span>
        </div>
        <p class="text-muted">Ces articles ont été sélectionnés selon la catégorie, la gamme de prix et les habitudes d'achat.</p>

        <div class="row row-cols-1 row-cols-md-4 g-3">
            @foreach (var rec in (IEnumerable<ProductManagement.Models.Product>)ViewBag.RecommendedProducts)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        <img src="~/images/@(rec.Image ?? "noimage.jpg")"
                             class="card-img-top p-2"
                             style="height: 180px; object-fit: cover;"
                             alt="@rec.Name" />
                        <div class="card-body p-3">
                            <span class="badge bg-light text-dark border mb-1">@rec.Category?.CategoryName</span>
                            <h6 class="card-title text-truncate fw-bold mb-1">@rec.Name</h6>
                            <p class="card-text text-primary fw-bold mb-2">@rec.Price DT</p>
                        </div>
                        <div class="card-footer bg-white border-0 p-2 pt-0 d-flex gap-1">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@rec.ProductId"
                               class="btn btn-outline-primary btn-sm w-50">
                                Détails
                            </a>
                            <a asp-controller="Panier" asp-action="AddProduct" asp-route-id="@rec.ProductId"
                               class="btn btn-primary btn-sm w-50">
                                + Panier
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}