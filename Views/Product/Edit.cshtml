@model ProductManagement.ViewModels.EditViewModel

@{
    ViewData["Title"] = "Modifier le produit";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square text-warning me-2"></i>Modifier : @Model.Name</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Retour à la liste</a>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <input type="hidden" asp-for="ProductId" />
                    <input type="hidden" asp-for="ExistingImagePath" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Nom du produit</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">Prix (DT)</label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="QteStock" class="form-label fw-semibold">Quantité en Stock</label>
                            <input asp-for="QteStock" class="form-control" />
                            <span asp-validation-for="QteStock" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Catégorie</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select"></select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4 align-items-center">
                        <div class="col-md-8">
                            <label asp-for="ImagePath" class="form-label fw-semibold">Remplacer l'image</label>
                            <input asp-for="ImagePath" class="form-control" type="file" />
                            <span asp-validation-for="ImagePath" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 text-center">
                            @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                            {
                                <label class="form-label text-muted small d-block">Image actuelle</label>
                                <img src="~/images/@Model.ExistingImagePath"
                                     alt="@Model.Name"
                                     class="img-thumbnail shadow-sm"
                                     style="max-height: 100px; object-fit: contain;" />
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning px-4 text-dark fw-bold shadow">
                            <i class="bi bi-save me-1"></i> Enregistrer les modifications
                        </button>
                        <a asp-action="Index" class="btn btn-light px-3">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>