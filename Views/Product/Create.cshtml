@model ProductManagement.ViewModels.CreateViewModel

@{
    ViewData["Title"] = "Ajouter un produit";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Nouveau Produit</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Retour à la liste</a>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Nom du produit</label>
                        <input asp-for="Name" class="form-control" placeholder="Ex: Clavier Mécanique RGB" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">Prix (DT)</label>
                            <input asp-for="Price" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="QteStock" class="form-label fw-semibold">Quantité en Stock</label>
                            <input asp-for="QteStock" class="form-control" placeholder="Ex: 25" />
                            <span asp-validation-for="QteStock" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Catégorie</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select">
                            <option value="">-- Sélectionner une catégorie --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ImagePath" class="form-label fw-semibold">Photo du produit</label>
                        <input asp-for="ImagePath" class="form-control" type="file" />
                        <span asp-validation-for="ImagePath" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4 shadow">
                            <i class="bi bi-check-lg"></i> Enregistrer le produit
                        </button>
                        <a asp-action="Index" class="btn btn-light px-3">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>