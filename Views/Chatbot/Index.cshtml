@{
    ViewData["Title"] = "NexusBot - Assistant Intelligent";
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <div class="row align-items-center mb-4">
        <div class="col-md-7">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Accueil</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Assistant AI</li>
                </ol>
            </nav>
            <h1 class="display-6 fw-bold mb-1 d-flex align-items-center gap-2">
                <span class="navbar-brand-badge" style="width: 48px; height: 48px; font-size: 1.5rem;">
                    <i class="bi bi-robot"></i>
                </span>
                <span>NexusBot AI Assistant</span>
            </h1>
            <p class="text-secondary mb-0">
                Interrogez en langage naturel les stocks de la boutique, comparez les prix ou <strong>téléchargez une photo de produit</strong> pour l'identifier visuellement instantanément.
            </p>
        </div>
        <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex flex-wrap justify-content-md-end gap-2 align-items-center">
            <a asp-action="Analytics" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-bar-chart-fill me-1"></i> Analytics
            </a>
            <a asp-action="History" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-clock-history me-1"></i> Historique
            </a>
            <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fs-6 rounded-pill">
                <i class="bi bi-circle-fill me-1 fs-6"></i> Stock connecté
            </span>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Recherche Visuelle</span>
                    <span class="badge bg-primary-subtle text-primary rounded-pill p-2"><i class="bi bi-camera fs-5"></i></span>
                </div>
                <h5 class="fw-bold mb-1">Reconnaissance Image</h5>
                <p class="text-muted small mb-0">Analysez des photos par comparaison visuelle & dHash</p>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Surveillance Stock</span>
                    <span class="badge bg-success-subtle text-success rounded-pill p-2"><i class="bi bi-box-seam fs-5"></i></span>
                </div>
                <h5 class="fw-bold mb-1">Disponibilité Directe</h5>
                <p class="text-muted small mb-0">Informations exactes sur les quantités restantes</p>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Achat Rapide</span>
                    <span class="badge bg-warning-subtle text-warning rounded-pill p-2"><i class="bi bi-cart-plus fs-5"></i></span>
                </div>
                <h5 class="fw-bold mb-1">Ajout en 1 Clic</h5>
                <p class="text-muted small mb-0">Ajoutez les articles suggérés sans quitter la conversation</p>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Recommandations</span>
                    <span class="badge bg-info-subtle text-info rounded-pill p-2"><i class="bi bi-stars fs-5"></i></span>
                </div>
                <h5 class="fw-bold mb-1">Moteur Hybride</h5>
                <p class="text-muted small mb-0">Suggestions de produits similaires & co-achats</p>
            </div>
        </div>
    </div>

    <!-- Main Full-Page Chat Container -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5">
        <div class="row g-0">
            <!-- Sidebar: Guided Prompts & Capabilities -->
            <div class="col-lg-4 border-end bg-light p-4 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-lightbulb text-warning"></i> Exemples de questions
                    </h5>

                    <p class="text-secondary small mb-3">
                        Cliquez sur une question type pour l'envoyer directement à l'assistant :
                    </p>

                    <div class="d-flex flex-column gap-2 mb-4">
                        <button type="button" class="btn btn-outline-primary text-start btn-sm py-2 rounded-3 prompt-suggestion-btn">
                            <i class="bi bi-box-arrow-in-down-right me-1"></i> Est-ce que le Dell XPS 15 est en stock ?
                        </button>
                        <button type="button" class="btn btn-outline-primary text-start btn-sm py-2 rounded-3 prompt-suggestion-btn">
                            <i class="bi bi-graph-up me-1"></i> Quel est l'état global du stock de la boutique ?
                        </button>
                        <button type="button" class="btn btn-outline-primary text-start btn-sm py-2 rounded-3 prompt-suggestion-btn">
                            <i class="bi bi-exclamation-triangle me-1"></i> Y a-t-il des articles en rupture ou stock faible ?
                        </button>
                        <button type="button" class="btn btn-outline-primary text-start btn-sm py-2 rounded-3 prompt-suggestion-btn">
                            <i class="bi bi-headphones me-1"></i> Quels sont les produits de la catégorie Audio & Son ?
                        </button>
                        <button type="button" class="btn btn-outline-primary text-start btn-sm py-2 rounded-3 prompt-suggestion-btn">
                            <i class="bi bi-tag me-1"></i> Quels sont les produits à moins de 500 DT ?
                        </button>
                    </div>

                    <div class="card border border-primary-subtle bg-white p-3 rounded-3 shadow-none">
                        <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold">
                            <i class="bi bi-camera-fill fs-5"></i>
                            <span>Recherche par Image</span>
                        </div>
                        <p class="text-secondary small mb-2">
                            Vous possédez la photo d'un ordinateur, smartphone, casque, montre ou souris ? Envoyez-la pour connaître instantanément sa disponibilité en stock et son prix.
                        </p>
                        <button type="button" class="btn btn-primary btn-sm rounded-pill w-100" id="fullpageUploadTriggerBtn">
                            <i class="bi bi-upload me-1"></i> Télécharger une photo
                        </button>
                    </div>
                </div>

                <div class="pt-4 mt-3 border-top text-center text-muted small">
                    <i class="bi bi-cpu me-1"></i> Propulsé par moteur visuel dHash & analyse temps réel
                </div>
            </div>

            <!-- Chat Panel Area -->
            <div class="col-lg-8 bg-white d-flex flex-column" style="height: 640px;">
                <!-- Fullpage Chat Messages Header -->
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-white">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success rounded-circle p-1" style="width: 10px; height: 10px;"></span>
                        <span class="fw-bold">Session de discussion active</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" id="fullpageResetBtn">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Réinitialiser
                    </button>
                </div>

                <!-- Messages Scroll Area -->
                <div class="flex-grow-1 p-4 overflow-y-auto" id="fullpageChatMessages">
                    <!-- Dynamic Messages will be populated -->
                </div>

                <!-- Typing indicator -->
                <div class="px-4 py-2 d-none" id="fullpageChatTyping">
                    <div class="typing-bubble">
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                    </div>
                </div>

                <!-- Attached image preview -->
                <div class="px-4 py-2 border-top bg-light d-none" id="fullpagePreviewBar">
                    <div class="d-flex align-items-center gap-3">
                        <img id="fullpageImgPreview" src="" alt="Aperçu" style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px;" />
                        <div class="flex-grow-1">
                            <span class="fw-semibold small d-block" id="fullpagePreviewName">photo.jpg</span>
                            <span class="text-muted text-xs">Image sélectionnée pour analyse visuelle</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-circle" id="fullpageRemoveImgBtn">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>

                <!-- Input Footer -->
                <div class="p-3 border-top bg-white">
                    <form id="fullpageChatForm" class="d-flex align-items-center gap-2">
                        <input type="file" id="fullpageFileInput" accept="image/*" class="d-none" />

                        <button type="button" class="btn btn-outline-secondary rounded-circle" id="fullpageAttachBtn" title="Joindre une photo de produit" style="width: 44px; height: 44px;">
                            <i class="bi bi-camera-fill fs-5"></i>
                        </button>

                        <input type="text"
                               id="fullpageChatInput"
                               class="form-control rounded-pill px-4 py-2 shadow-none border-secondary-subtle"
                               placeholder="Posez une question sur le stock, un prix ou envoyez une photo..."
                               autocomplete="off" />

                        <button type="submit" class="btn btn-primary rounded-circle shadow-sm" style="width: 44px; height: 44px;">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Synchronize and hook full page interactions with chatbot engine
        $(document).ready(function() {
            // When user clicks a prompt suggestion on full page
            $('.prompt-suggestion-btn').on('click', function() {
                var text = $(this).text().trim();
                $('#fullpageChatInput').val(text);
                $('#fullpageChatForm').submit();
            });

            $('#fullpageUploadTriggerBtn, #fullpageAttachBtn').on('click', function() {
                $('#fullpageFileInput').click();
            });

            $('#fullpageFileInput').on('change', function(e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function(evt) {
                        $('#fullpageImgPreview').attr('src', evt.target.result);
                        $('#fullpagePreviewName').text(file.name);
                        $('#fullpagePreviewBar').removeClass('d-none');
                    };
                    reader.readAsDataURL(file);
                }
            });

            $('#fullpageRemoveImgBtn').on('click', function() {
                $('#fullpageFileInput').val('');
                $('#fullpagePreviewBar').addClass('d-none');
            });

            // Initialize conversation on fullpage view
            initFullpageChat();

            $('#fullpageChatForm').on('submit', function(e) {
                e.preventDefault();
                var message = $('#fullpageChatInput').val().trim();
                var fileInput = document.getElementById('fullpageFileInput');
                var hasFile = fileInput.files && fileInput.files.length > 0;

                if (!message && !hasFile) return;

                // Append user message
                var imgSrc = hasFile ? $('#fullpageImgPreview').attr('src') : null;
                appendFullpageUserMessage(message, imgSrc);

                // Prepare form data
                var formData = new FormData();
                if (message) formData.append('message', message);
                if (hasFile) formData.append('image', fileInput.files[0]);

                // Clear input
                $('#fullpageChatInput').val('');
                $('#fullpageFileInput').val('');
                $('#fullpagePreviewBar').addClass('d-none');

                $('#fullpageChatTyping').removeClass('d-none');
                scrollFullpageChat();

                $.ajax({
                    url: '/Chatbot/SendMessage',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        $('#fullpageChatTyping').addClass('d-none');
                        if (res.success && res.data) {
                            appendFullpageBotMessage(res.data);
                        } else {
                            appendFullpageBotMessage({
                                reply: "Désolé, une erreur s'est produite lors de la communication avec le serveur.",
                                products: [],
                                quickReplies: ["Recommencer"]
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#fullpageChatTyping').addClass('d-none');
                        console.error("Fullpage chatbot error:", status, error, xhr);
                        var detail = xhr.status ? " (Code HTTP " + xhr.status + ")" : " (Serveur déconnecté)";
                        appendFullpageBotMessage({
                            reply: "Désolé, impossible de joindre le serveur" + detail + ". Veuillez vérifier que le serveur est bien démarré.",
                            products: [],
                            quickReplies: ["Réessayer"]
                        });
                    }
                });
            });

            $('#fullpageResetBtn').on('click', function() {
                $('#fullpageChatMessages').empty();
                initFullpageChat();
            });

            function initFullpageChat() {
                var welcome = {
                    reply: "👋 Bonjour ! Je suis **NexusBot**, votre assistant dédié au catalogue et aux stocks de NexusStore.\n\nVous pouvez me demander la disponibilité en temps réel de n'importe quel produit, filtrer par budget ou m'envoyer la photo d'un produit pour que je le retrouve pour vous !",
                    products: [],
                    quickReplies: [
                        "📦 Vérifier l'état des stocks",
                        "💻 Ordinateurs & Laptops",
                        "🎧 Casques & Audio",
                        "💰 Moins de 500 DT",
                        "⚠️ Articles en rupture ou stock faible"
                    ],
                    timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                };
                appendFullpageBotMessage(welcome);
            }

            function appendFullpageUserMessage(text, imgSrc) {
                var html = '<div class="d-flex justify-content-end mb-3">';
                html += '<div class="bg-primary text-white p-3 rounded-4 shadow-sm" style="max-width: 80%;">';
                if (imgSrc) {
                    html += '<img src="' + imgSrc + '" class="rounded-3 mb-2 img-fluid d-block" style="max-height: 180px; object-fit: contain; background: rgba(0,0,0,0.1); padding: 4px;" />';
                }
                if (text) {
                    html += '<div class="fw-normal">' + escapeHtml(text) + '</div>';
                }
                html += '</div></div>';
                $('#fullpageChatMessages').append(html);
                scrollFullpageChat();
            }

            function appendFullpageBotMessage(data) {
                var html = '<div class="d-flex gap-3 mb-4">';
                html += '<div class="navbar-brand-badge flex-shrink-0" style="width: 38px; height: 38px; font-size: 1.1rem;"><i class="bi bi-robot"></i></div>';
                html += '<div class="flex-grow-1" style="max-width: 85%;">';
                html += '<div class="bg-light p-3 rounded-4 border shadow-sm">';
                html += '<div class="text-dark message-body">' + formatBotMarkdown(data.reply) + '</div>';

                // If products attached
                if (data.products && data.products.length > 0) {
                    html += '<div class="row g-2 mt-3">';
                    data.products.forEach(function(p) {
                        html += '<div class="col-md-6">';
                        html += '<div class="card h-100 border rounded-3 p-2 shadow-none bg-white">';
                        html += '<div class="d-flex gap-2">';
                        html += '<img src="' + p.imageUrl + '" alt="' + p.name + '" style="width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" class="border" />';
                        html += '<div class="flex-grow-1 min-w-0">';
                        html += '<span class="badge bg-secondary-subtle text-secondary small" style="font-size: 0.7rem;">' + p.categoryName + '</span>';
                        html += '<h6 class="fw-bold mb-1 text-truncate" title="' + p.name + '">' + p.name + '</h6>';
                        html += '<div class="d-flex align-items-center justify-content-between">';
                        html += '<span class="fw-bold text-primary">' + p.price.toFixed(2) + ' DT</span>';
                        html += '<span class="badge bg-' + p.stockBadgeClass + '-subtle text-' + p.stockBadgeClass + ' border border-' + p.stockBadgeClass + '-subtle rounded-pill">' + p.stockStatus + '</span>';
                        html += '</div>';
                        html += '</div>';
                        html += '</div>';

                        if (p.confidencePercent) {
                            html += '<div class="mt-2 text-xs text-muted d-flex align-items-center gap-1">';
                            html += '<i class="bi bi-bullseye text-primary"></i> Correspondance photo : <strong>' + p.confidencePercent + '%</strong>';
                            html += '</div>';
                        }

                        html += '<div class="d-flex gap-2 mt-2 pt-2 border-top">';
                        html += '<button type="button" class="btn btn-sm btn-primary flex-grow-1 chatbot-add-cart-btn" data-product-id="' + p.productId + '">';
                        html += '<i class="bi bi-cart-plus me-1"></i> Ajouter';
                        html += '</button>';
                        html += '<a href="/Product/Details/' + p.productId + '" class="btn btn-sm btn-outline-secondary">';
                        html += '<i class="bi bi-eye"></i>';
                        html += '</a>';
                        html += '</div>';

                        html += '</div></div>';
                    });
                    html += '</div>';
                }

                html += '</div>';

                // Quick replies chips
                if (data.quickReplies && data.quickReplies.length > 0) {
                    html += '<div class="d-flex flex-wrap gap-1 mt-2">';
                    data.quickReplies.forEach(function(qr) {
                        html += '<button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-3 text-xs fullpage-chip-btn" data-query="' + qr + '">';
                        html += qr;
                        html += '</button>';
                    });
                    html += '</div>';
                }

                html += '</div></div>';

                $('#fullpageChatMessages').append(html);
                scrollFullpageChat();
            }

            // Quick chip click in full page
            $(document).on('click', '.fullpage-chip-btn', function() {
                var query = $(this).data('query');
                $('#fullpageChatInput').val(query);
                $('#fullpageChatForm').submit();
            });

            // Add to cart from chatbot button
            $(document).on('click', '.chatbot-add-cart-btn', function() {
                var btn = $(this);
                var prodId = btn.data('product-id');
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Ajout...');

                $.ajax({
                    url: '/Chatbot/AddToCartAjax',
                    type: 'POST',
                    data: { productId: prodId },
                    success: function(resp) {
                        if (resp.success) {
                            btn.removeClass('btn-primary').addClass('btn-success').html('<i class="bi bi-check-lg me-1"></i> Ajouté !');
                            // Update badge in navbar
                            var cartBadge = $('a[href*="/Panier"] .badge');
                            if (cartBadge.length) {
                                cartBadge.text(resp.cartCount);
                            } else {
                                $('a[href*="/Panier"]').append('<span class="badge bg-danger rounded-pill px-2 py-1 ms-1">' + resp.cartCount + '</span>');
                            }
                            setTimeout(function() {
                                btn.removeClass('btn-success').addClass('btn-primary').prop('disabled', false).html('<i class="bi bi-cart-plus me-1"></i> Ajouter');
                            }, 2500);
                        } else {
                            alert(resp.message || "Erreur lors de l'ajout.");
                            btn.prop('disabled', false).html('<i class="bi bi-cart-plus me-1"></i> Ajouter');
                        }
                    },
                    error: function() {
                        btn.prop('disabled', false).html('<i class="bi bi-cart-plus me-1"></i> Ajouter');
                    }
                });
            });

            function scrollFullpageChat() {
                var msgBox = document.getElementById('fullpageChatMessages');
                if (msgBox) {
                    msgBox.scrollTop = msgBox.scrollHeight;
                }
            }

            function formatBotMarkdown(text) {
                if (!text) return "";
                var formatted = escapeHtml(text);
                formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\*(.*?)\*/g, '<em>$1</em>');
                formatted = formatted.replace(/\n\n/g, '<br/><br/>');
                formatted = formatted.replace(/\n/g, '<br/>');
                return formatted;
            }

            function escapeHtml(string) {
                var entityMap = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                };
                return String(string).replace(/[&<>"']/g, function (s) {
                    return entityMap[s];
                });
            }
        });
    </script>
}
