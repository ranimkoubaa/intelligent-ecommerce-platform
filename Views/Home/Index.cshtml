@{
    ViewData["Title"] = "Accueil";
}

<div class="hero-banner text-center mb-5">
    <div class="container py-4 position-relative">
        <span class="badge bg-white bg-opacity-25 text-white px-3 py-2 rounded-pill mb-3">
            <i class="bi bi-stars text-warning me-1"></i> Plateforme E-Commerce Intelligente
        </span>
        <h1 class="display-4 fw-extrabold text-white mb-3">
            Découvrez l'Excellence Technologique avec NexusStore
        </h1>
        <p class="col-lg-8 mx-auto fs-5 text-white-50 mb-4">
            Catalogue complet, recommandations personnalisées par IA et gestion de commandes en temps réel.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg shadow">
                <i class="bi bi-grid-fill"></i> Explorer le Catalogue
            </a>
            <a asp-controller="Panier" asp-action="Index" class="btn btn-outline-light btn-lg">
                <i class="bi bi-cart3"></i> Accéder au Panier
            </a>
        </div>
    </div>
</div>

@if (ViewBag.TrendingProducts != null && ((IEnumerable<ProductManagement.Models.Product>)ViewBag.TrendingProducts).Any())
{
    <div class="my-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="h3 fw-bold mb-1">🔥 Produits Populaires & Recommandés</h2>
                <p class="text-muted mb-0">Les articles les plus plébiscités par nos clients</p>
            </div>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">Voir tout le catalogue →</a>
        </div>

        <div class="row row-cols-1 row-cols-md-4 g-4">
            @foreach (var p in (IEnumerable<ProductManagement.Models.Product>)ViewBag.TrendingProducts)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge bg-danger">Top Vente</span>
                        </div>
                        <div class="text-center p-3" style="height: 180px;">
                            <img src="~/images/@(p.Image ?? "noimage.jpg")"
                                 class="img-fluid"
                                 style="max-height: 100%; object-fit: contain;"
                                 alt="@p.Name" />
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <span class="badge bg-light text-muted border small mb-1 align-self-start">
                                @(p.Category?.CategoryName ?? "Produit")
                            </span>
                            <h6 class="card-title text-truncate fw-bold mb-1" title="@p.Name">@p.Name</h6>
                            <p class="fs-5 text-primary fw-bold mb-3">@p.Price DT</p>

                            <div class="mt-auto d-flex gap-1">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductId"
                                   class="btn btn-outline-primary btn-sm w-50">
                                    Détails
                                </a>
                                <a asp-controller="Panier" asp-action="AddProduct" asp-route-id="@p.ProductId"
                                   class="btn btn-success btn-sm w-50">
                                    🛒 Panier
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="row text-center mt-5 g-4">
    <div class="col-md-4">
        <div class="card h-100 p-4 border-0 shadow-sm text-start">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-3 p-3 mb-3" style="width: 54px; height: 54px;">
                <i class="bi bi-box-seam fs-3"></i>
            </div>
            <h4 class="fw-bold mb-2">Catalogue Dynamique</h4>
            <p class="text-muted mb-4">Parcourez une large sélection d'articles avec pagination optimisée et filtres par catégorie.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-sm mt-auto align-self-start">
                Explorer <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 p-4 border-0 shadow-sm text-start">
            <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-3 p-3 mb-3" style="width: 54px; height: 54px;">
                <i class="bi bi-lightning-charge fs-3"></i>
            </div>
            <h4 class="fw-bold mb-2">Panier Interactif</h4>
            <p class="text-muted mb-4">Ajustement fluide des quantités en AJAX sans rechargement et suggestions complémentaires instantanées.</p>
            <a asp-controller="Panier" asp-action="Index" class="btn btn-outline-success btn-sm mt-auto align-self-start">
                Voir le Panier <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 p-4 border-0 shadow-sm text-start">
            <div class="d-inline-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info rounded-3 p-3 mb-3" style="width: 54px; height: 54px;">
                <i class="bi bi-shield-check fs-3"></i>
            </div>
            <h4 class="fw-bold mb-2">Commandes & Factures</h4>
            <p class="text-muted mb-4">Processus de paiement sécurisé, gestion des rôles utilisateur et impression de factures officielles.</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-info btn-sm mt-auto align-self-start">
                Se Connecter <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>
