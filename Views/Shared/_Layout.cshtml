@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - NexusStore Pro</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Modern Custom Design System CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProductManagement.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container-fluid px-lg-4">

                <!-- Bouton Drawer pour les Catégories -->
                <button class="btn btn-outline-primary btn-sm me-2 shadow-sm" type="button" id="toggleMenu" title="Menu des catégories">
                    <i class="bi bi-grid-3x3-gap-fill fs-5"></i>
                </button>

                <!-- Brand Logo -->
                <a class="navbar-brand-custom me-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="navbar-brand-badge">
                        <i class="bi bi-box-seam-fill"></i>
                    </span>
                    <span>NexusStore</span>
                </a>

                <!-- Responsive Toggler -->
                <button class="navbar-toggler border-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Nav Items & Search -->
                <div class="collapse navbar-collapse" id="navbarContent">

                    <!-- Liens Principaux -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Accueil
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-custom" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-bag"></i> Produits
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-custom" asp-controller="Category" asp-action="Index">
                                <i class="bi bi-tags"></i> Catégories
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-custom position-relative" asp-controller="Panier" asp-action="Index">
                                <i class="bi bi-cart3"></i> Panier
                                @{
                                    var cartCount = ProductManagement.Models.Help.ListeCart.Instance.Items.Sum(i => i.quantite);
                                    if (cartCount > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill px-2 py-1 ms-1">@cartCount</span>
                                    }
                                }
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link-custom dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="background: rgba(79, 70, 229, 0.08); border-radius: 8px;">
                                <i class="bi bi-robot text-primary"></i> <span class="fw-semibold text-primary">Assistant AI</span>
                            </a>
                            <ul class="dropdown-menu shadow-lg border-0 rounded-3 mt-2">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Chatbot" asp-action="Index">
                                        <i class="bi bi-chat-dots-fill text-primary me-2"></i> Ouvrir le Chatbot
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Chatbot" asp-action="Analytics">
                                        <i class="bi bi-cpu text-info me-2"></i> Dashboard Analytics
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Chatbot" asp-action="History">
                                        <i class="bi bi-clock-history text-secondary me-2"></i> Historique des échanges
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Menu Administration (Admin Role) -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link-custom dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-speedometer2"></i> Administration
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0 rounded-3 mt-2">
                                    <li>
                                        <a class="dropdown-item py-2 fw-semibold text-primary" asp-controller="Admin" asp-action="Dashboard">
                                            <i class="bi bi-graph-up-arrow me-2"></i> Tableau de bord Analytics
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="CreateRole">
                                            <i class="bi bi-shield-plus me-2"></i> Créer un rôle
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="ListRoles">
                                            <i class="bi bi-people me-2"></i> Liste des rôles
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Chatbot" asp-action="Analytics">
                                            <i class="bi bi-cpu text-info me-2"></i> NexusBot Analytics
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Chatbot" asp-action="History">
                                            <i class="bi bi-clock-history text-primary me-2"></i> Historique Chatbot
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Recherche Moderne -->
                    <form asp-controller="Product" asp-action="Search" method="get" class="search-input-group me-lg-3 my-2 my-lg-0">
                        <i class="bi bi-search search-icon"></i>
                        <input class="form-control" type="search" name="name" placeholder="Rechercher un produit..." aria-label="Search" />
                    </form>

                    <!-- Authentification -->
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link-custom dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 text-primary"></i>
                                    <span>@User.Identity?.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                                    <li>
                                        <form method="post" asp-controller="Account" asp-action="Logout" class="px-2 py-1">
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                                <i class="bi bi-box-arrow-right me-1"></i> Déconnexion
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Connexion
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Inscription
                                </a>
                            </li>
                        }
                    </ul>

                </div>

            </div>
        </nav>
    </header>


    <!-- ================= CONTENU PRINCIPAL ================= -->
    <div class="container-fluid px-lg-4 my-4">
        <div class="row">
            <!-- Menu latéral pour les catégories -->
            <div class="col-md-3 col-xl-2" id="sidebar" style="display: none;">
                @await Html.PartialAsync("_CategoriesMenu", ViewData["Categories"])
            </div>

            <!-- Contenu de la page -->
            <div class="col-md-12" id="mainContent">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>


    <!-- ================= FOOTER ================= -->
    <footer class="footer-custom">
        <div class="container-fluid px-lg-5">
            <div class="row g-4 mb-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="navbar-brand-badge">
                            <i class="bi bi-box-seam-fill"></i>
                        </span>
                        <h4 class="text-white mb-0 fw-bold">NexusStore</h4>
                    </div>
                    <p class="text-secondary small mb-3">
                        Plateforme e-commerce nouvelle génération développée sous ASP.NET Core MVC avec moteur de recommandation intelligent & système analytique avancé.
                    </p>
                    <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2">Master DSIR .NET Pro</span>
                </div>

                <div class="col-6 col-lg-2 offset-lg-2">
                    <h5>Navigation</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="Home" asp-action="Index">Accueil</a></li>
                        <li><a asp-controller="Product" asp-action="Index">Catalogue Produits</a></li>
                        <li><a asp-controller="Category" asp-action="Index">Catégories</a></li>
                        <li><a asp-controller="Panier" asp-action="Index">Mon Panier</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h5>Mon Compte</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="Account" asp-action="Login">Se connecter</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Créer un compte</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Confidentialité</a></li>
                    </ul>
                </div>

                <div class="col-lg-2">
                    <h5>Technologies</h5>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-dark border border-secondary text-secondary">ASP.NET 9</span>
                        <span class="badge bg-dark border border-secondary text-secondary">EF Core</span>
                        <span class="badge bg-dark border border-secondary text-secondary">Identity</span>
                        <span class="badge bg-dark border border-secondary text-secondary">Chart.js</span>
                    </div>
                </div>
            </div>

            <div class="border-top border-secondary pt-3 text-center text-secondary small">
                &copy; @DateTime.Now.Year NexusStore - Master DSIR ProductManagement. Tous droits réservés.
            </div>
        </div>
    </footer>

    <!-- ================= CHATBOT WIDGET ================= -->
    @await Html.PartialAsync("_ChatbotWidget")

    <!-- ================= SCRIPTS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/CustomScript.js" asp-append-version="true"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>