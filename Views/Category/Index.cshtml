@model IEnumerable<ProductManagement.Models.Category>

@{
    ViewData["Title"] = "Gestion des Catégories";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h2 mb-1">🏷️ Gestion des Catégories</h1>
        <p class="text-muted mb-0">Organisez vos produits par univers et départements</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Ajouter une catégorie
        </a>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;"># ID</th>
                        <th>Nom de la catégorie</th>
                        <th class="text-end" style="width: 250px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                Aucune catégorie enregistrée pour le moment.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="text-muted fw-bold">#@category.CategoryId</td>
                                <td>
                                    <span class="fw-semibold text-dark fs-6">
                                        <i class="bi bi-tag-fill text-primary me-2"></i>@category.CategoryName
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@category.CategoryId" class="btn btn-outline-secondary" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@category.CategoryId" class="btn btn-outline-warning" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@category.CategoryId" class="btn btn-outline-danger" title="Supprimer">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>