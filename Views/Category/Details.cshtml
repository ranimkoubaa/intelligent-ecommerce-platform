@model ProductManagement.Models.Category

@{
    ViewData["Title"] = "Détails de la catégorie";
}

<h1 class="mb-4">Détails de la catégorie</h1>

<div class="card mb-4" style="max-width: 700px;">

    <div class="card-header">
        <h4 class="mb-0">@Model.CategoryName</h4>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Nom de la catégorie</dt>
            <dd class="col-sm-8">@Model.CategoryName</dd>

            <dt class="col-sm-4">Nombre de produits</dt>
            <dd class="col-sm-8">@Model.Products.Count()</dd>
        </dl>

        @if (Model.Products != null && Model.Products.Any())
        {
            <h5 class="mt-3">Produits associés :</h5>
            <ul class="list-group">
                @foreach (var product in Model.Products)
                {
                    <li class="list-group-item">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId"
                           class="text-decoration-none">
                            @product.Name — @product.Price DT
                        </a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted mt-3">Aucun produit dans cette catégorie.</p>
        }
    </div>

    <div class="card-footer">
        <a asp-action="Edit"
           asp-route-id="@Model.CategoryId"
           class="btn btn-warning">
            Modifier
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Retour
        </a>
    </div>

</div>